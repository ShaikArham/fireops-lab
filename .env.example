# Frontend public API base URL. Set to the FastAPI origin when API-backed features are enabled.
NEXT_PUBLIC_API_BASE_URL=

# Backend local development
FIREOPS_ENV=development
FIREOPS_ENABLE_DEMO_WRITES=false
FIREOPS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./fireops.db

